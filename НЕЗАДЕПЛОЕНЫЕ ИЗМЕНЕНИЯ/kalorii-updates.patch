diff --git a/frontend/src/components/meals/WeekStripCalendar.tsx b/frontend/src/components/meals/WeekStripCalendar.tsx
new file mode 100644
index 0000000..3e12450
--- /dev/null
+++ b/frontend/src/components/meals/WeekStripCalendar.tsx
@@ -0,0 +1,230 @@
+import React, { useState, useEffect, useMemo } from 'react'
+import { ChevronLeft, ChevronRight, Calendar } from 'lucide-react'
+import { statsApi } from '../../api/stats'
+import { getTodayDateString, shiftDateString } from '../../store/mealsStore'
+
+interface WeekStripCalendarProps {
+  selectedDate: string
+  onSelectDate: (date: string) => void
+  currentDayCalories: number
+  dailyGoalCalories: number
+}
+
+const WEEKDAY_LABELS = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс']
+
+function formatYMD(d: Date): string {
+  const y = d.getFullYear()
+  const m = String(d.getMonth() + 1).padStart(2, '0')
+  const day = String(d.getDate()).padStart(2, '0')
+  return `${y}-${m}-${day}`
+}
+
+export const WeekStripCalendar: React.FC<WeekStripCalendarProps> = ({
+  selectedDate,
+  onSelectDate,
+  currentDayCalories,
+  dailyGoalCalories,
+}) => {
+  const [weekCaloriesMap, setWeekCaloriesMap] = useState<Record<string, number>>({})
+  const todayStr = getTodayDateString()
+  const isToday = selectedDate === todayStr
+
+  // Compute Monday..Sunday dates for the week containing selectedDate
+  const weekDays = useMemo(() => {
+    const [y, m, d] = selectedDate.split('-').map(Number)
+    const current = new Date(y, (m || 1) - 1, d || 1)
+    const jsDay = current.getDay() // 0 = Sun, 1 = Mon ... 6 = Sat
+    const mondayOffset = jsDay === 0 ? -6 : 1 - jsDay
+    const monday = new Date(y, (m || 1) - 1, (d || 1) + mondayOffset)
+
+    return Array.from({ length: 7 }, (_, i) => {
+      const dateObj = new Date(
+        monday.getFullYear(),
+        monday.getMonth(),
+        monday.getDate() + i
+      )
+      return {
+        dateStr: formatYMD(dateObj),
+        dayNumber: dateObj.getDate(),
+        weekdayShort: WEEKDAY_LABELS[i],
+      }
+    })
+  }, [selectedDate])
+
+  const mondayStr = weekDays[0].dateStr
+  const sundayStr = weekDays[6].dateStr
+
+  useEffect(() => {
+    let active = true
+    ;(async () => {
+      try {
+        const res = await statsApi.getStats('custom', mondayStr, sundayStr)
+        if (!active) return
+        const nextMap: Record<string, number> = {}
+        for (const item of res.daily_stats || []) {
+          nextMap[item.date] = item.calories || 0
+        }
+        setWeekCaloriesMap(nextMap)
+      } catch {
+        // Ignore network errors and rely on active day calories
+      }
+    })()
+    return () => {
+      active = false
+    }
+  }, [mondayStr, sundayStr])
+
+  const [selY, selM, selD] = selectedDate.split('-').map(Number)
+  const selectedDateObj = new Date(selY, (selM || 1) - 1, selD || 1)
+  const formattedHeaderDate = selectedDateObj.toLocaleDateString('ru-RU', {
+    day: 'numeric',
+    month: 'long',
+    weekday: 'short',
+  })
+
+  const safeGoal = dailyGoalCalories > 0 ? dailyGoalCalories : 2000
+
+  return (
+    <div className="bg-[#18181c]/95 p-3 rounded-2xl border border-neutral-800/80 shadow-md space-y-2.5">
+      {/* Top Bar: Previous Day/Week, Current Date Label, Today Jump, Next Day/Week */}
+      <div className="flex items-center justify-between">
+        <button
+          type="button"
+          onClick={() => onSelectDate(shiftDateString(selectedDate, -1))}
+          className="p-1.5 min-w-[36px] min-h-[36px] flex items-center justify-center text-neutral-400 hover:text-white hover:bg-neutral-800 rounded-xl transition-colors cursor-pointer active:scale-95"
+          title="Предыдущий день"
+        >
+          <ChevronLeft className="w-4 h-4" />
+        </button>
+
+        <div className="flex items-center gap-2">
+          <Calendar className="w-4 h-4 text-emerald-400 shrink-0" />
+          <span className="text-xs sm:text-sm font-semibold text-white capitalize">
+            {isToday ? `Сегодня, ${formattedHeaderDate}` : formattedHeaderDate}
+          </span>
+          {!isToday && (
+            <button
+              type="button"
+              onClick={() => onSelectDate(todayStr)}
+              className="text-[11px] font-medium text-emerald-400 hover:text-emerald-300 px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 transition-all cursor-pointer active:scale-95"
+            >
+              Сегодня
+            </button>
+          )}
+        </div>
+
+        <button
+          type="button"
+          onClick={() => onSelectDate(shiftDateString(selectedDate, 1))}
+          className="p-1.5 min-w-[36px] min-h-[36px] flex items-center justify-center text-neutral-400 hover:text-white hover:bg-neutral-800 rounded-xl transition-colors cursor-pointer active:scale-95"
+          title="Следующий день"
+        >
+          <ChevronRight className="w-4 h-4" />
+        </button>
+      </div>
+
+      {/* 7-Day Interactive Strip with Progress Rings */}
+      <div className="grid grid-cols-7 gap-1 sm:gap-1.5">
+        {weekDays.map((day) => {
+          const isSelected = day.dateStr === selectedDate
+          const isDayToday = day.dateStr === todayStr
+          const dayCals = isSelected
+            ? currentDayCalories
+            : weekCaloriesMap[day.dateStr] || 0
+
+          const ratio = Math.min(Math.max(dayCals / safeGoal, 0), 1)
+          const ringSize = 22
+          const strokeWidth = 2.6
+          const radius = (ringSize - strokeWidth) / 2
+          const circumference = 2 * Math.PI * radius
+          const dashOffset = circumference - ratio * circumference
+
+          const isGoalMet = dayCals >= safeGoal * 0.85 && dayCals <= safeGoal * 1.15
+          const isOverGoal = dayCals > safeGoal * 1.15
+          const strokeColor =
+            dayCals <= 0
+              ? 'transparent'
+              : isOverGoal
+              ? '#f59e0b'
+              : isGoalMet
+              ? '#10b981'
+              : '#34d399'
+
+          return (
+            <button
+              key={day.dateStr}
+              type="button"
+              onClick={() => onSelectDate(day.dateStr)}
+              className={`relative flex flex-col items-center justify-center py-1.5 px-1 rounded-xl border transition-all cursor-pointer active:scale-95 ${
+                isSelected
+                  ? 'bg-emerald-500/15 border-emerald-500/50 text-white shadow-sm'
+                  : 'bg-[#141417]/70 hover:bg-[#1f1f25] border-neutral-800/60 text-neutral-400 hover:text-neutral-200'
+              }`}
+              title={`${day.dateStr}: ${Math.round(dayCals)} ккал`}
+            >
+              {isDayToday && !isSelected && (
+                <span className="absolute top-1 right-1 w-1.5 h-1.5 rounded-full bg-emerald-400" />
+              )}
+
+              <span
+                className={`text-[10px] font-medium leading-none ${
+                  isSelected ? 'text-emerald-300 font-semibold' : 'text-neutral-400'
+                }`}
+              >
+                {day.weekdayShort}
+              </span>
+
+              <span
+                className={`text-xs font-bold mt-1 leading-none ${
+                  isSelected
+                    ? 'text-white'
+                    : isDayToday
+                    ? 'text-emerald-400'
+                    : 'text-neutral-200'
+                }`}
+              >
+                {day.dayNumber}
+              </span>
+
+              {/* Mini SVG Progress Ring */}
+              <div className="relative mt-1.5 flex items-center justify-center">
+                <svg
+                  width={ringSize}
+                  height={ringSize}
+                  viewBox={`0 0 ${ringSize} ${ringSize}`}
+                  className="-rotate-90"
+                >
+                  <circle
+                    cx={ringSize / 2}
+                    cy={ringSize / 2}
+                    r={radius}
+                    stroke="#27272a"
+                    strokeWidth={strokeWidth}
+                    fill="transparent"
+                  />
+                  {dayCals > 0 && (
+                    <circle
+                      cx={ringSize / 2}
+                      cy={ringSize / 2}
+                      r={radius}
+                      stroke={strokeColor}
+                      strokeWidth={strokeWidth}
+                      strokeDasharray={circumference}
+                      strokeDashoffset={dashOffset}
+                      strokeLinecap="round"
+                      fill="transparent"
+                      className="transition-all duration-300"
+                    />
+                  )}
+                </svg>
+                {isGoalMet && (
+                  <span className="absolute w-1.5 h-1.5 rounded-full bg-emerald-400" />
+                )}
+              </div>
+            </button>
+          )
+        })}
+      </div>
+    </div>
+  )
+}
