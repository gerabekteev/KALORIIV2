+
+async def cleanup_orphan_uploads(db: AsyncSession, max_age_hours: int = 24) -> int:
+    """
+    Remove uploaded image files older than max_age_hours that are not referenced
+    by any Meal.photo_path or Product.image_url.
+    """
+    if not settings.UPLOAD_DIR.exists():
+        return 0
+
+    from app.models.meal import Meal
+    from app.models.product import Product
+
+    meal_paths_res = await db.execute(select(Meal.photo_path).where(Meal.photo_path.is_not(None)))
+    prod_paths_res = await db.execute(select(Product.image_url).where(Product.image_url.is_not(None)))
+
+    referenced_filenames = set()
+    for p in list(meal_paths_res.scalars().all()) + list(prod_paths_res.scalars().all()):
+        if p and isinstance(p, str):
+            referenced_filenames.add(Path(p).name)
+
+    now = time.time()
+    cutoff = now - (max_age_hours * 3600)
+    removed = 0
+
+    for file_path in settings.UPLOAD_DIR.glob("*.jpg"):
+        try:
+            if file_path.name not in referenced_filenames and file_path.stat().st_mtime < cutoff:
+                file_path.unlink()
+                removed += 1
+        except Exception as e:
+            logger.debug(f"Could not remove orphan upload {file_path}: {e}")
+
+    return removed
