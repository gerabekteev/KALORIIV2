# KaloriiAI Environment Variables Configuration

# Application settings
DEBUG=false
PROJECT_NAME="KaloriiAI"

# SQLite Async Database URL (default: data/db.sqlite3)
DATABASE_URL=sqlite+aiosqlite:///./data/db.sqlite3

# Secret key for JWT token encryption (generate a secure random 32+ char key)
JWT_SECRET=replace_with_a_super_secret_jwt_key_at_least_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI Provider API Keys
# Google AI Studio (free key: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenRouter (free models: https://openrouter.ai/)
OPENROUTER_API_KEY=

# Telegram Bot (get token from @BotFather)
TELEGRAM_BOT_TOKEN=8974113702:AAFQI_QJC5YF6ITIxPiG4xx91b4yI7YuyGU
TELEGRAM_BOT_USERNAME=KaloriiV2bot

# Optional: Proxy for Gemini API if server IP is blocked by Google (e.g. Russia geo-marking)
# Can use socks5 (e.g. socks5://127.0.0.1:2080 or socks5://127.0.0.1:40000) or http proxy
GEMINI_PROXY_URL=
# Or custom reverse proxy base URL (e.g. Cloudflare Worker or AI Gateway)
# GEMINI_BASE_URL=https://your-cf-worker.workers.dev/v1beta/models

# Storage & Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Rate limits
RATE_LIMIT_AI_PER_MINUTE=10

# CORS Allowed Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","https://kalorii.lopni.fun"]
