# ==========================================
# KaloriiAI .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
.agents/mcp_config.json
.agents/plugins/**/mcp_config.json
.vscode/mcp.json
.antigravity/
.gemini/

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.ENV/
.env/

# Pytest & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Node.js & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/*.tsbuildinfo
.eslintcache

# SQLite & Database files
*.sqlite
*.sqlite3
*.db
backend/data/*.sqlite*
backend/data/*.db
!backend/data/.gitkeep
!backend/data/products_seed.json

# User Uploads
backend/uploads/*
!backend/uploads/.gitkeep

# IDEs & Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Logs
logs/
*.log

# ==========================================
# Android & Capacitor build artifacts
# ==========================================
frontend/android/.gradle/
frontend/android/.idea/
frontend/android/build/
frontend/android/app/build/
frontend/android/capacitor-cordova-android-plugins/
frontend/android/local.properties
frontend/android/app/src/main/assets/public/
frontend/android/gradle/wrapper/*.zip
*.jks
*.keystore
kalorii-ai-debug.apk
/kalorii-ai.apk
!backend/static/kalorii-ai.apk

